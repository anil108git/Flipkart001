{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
      "environment": {
        "PLAYWRIGHT_HEADLESS": "true"
      }
    },
    "jira": {
      "type": "local",
      "command": ["bash", "-c", "set -a && source .env && set +a && export JIRA_USERNAME=\"$JIRA_USER_EMAIL\" && exec uvx mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "https://kanilme.atlassian.net",
        "TOOLSETS": "default,jira_links,jira_attachments"
      }
    }
  }
}
